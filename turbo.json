{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "JAVA_HOME",
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "ANDROID_NDK_HOME",
    "GRADLE_USER_HOME",
    "GRADLE_OPTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Internal packages compile to dist/, which is what @repo/* imports
    // resolve against. `watch` keeps that output in sync while an app dev
    // server runs. It is deliberately named differently from `dev` so the
    // dev:mobile:* scripts can glob every package with --filter=./packages/*
    // without also sweeping in an app's own `dev` task.
    "watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:android": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:ios": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build:android": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build:ios": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build:android:clean": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build:ios:clean": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
